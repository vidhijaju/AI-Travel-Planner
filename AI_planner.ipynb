# =========================================================
# GET TRAVEL DATA FROM GEMINI
# =========================================================

def create_travel_plan(country, days, budget):

    prompt = f"""
Create a detailed travel plan for:

Country: {country}
Number of Days: {days}
Budget: ${budget}

Return ONLY valid JSON.

Use this structure:

{{
    "country": "{country}",

    "overview": "Detailed overview",

    "famous_places": [
        {{
            "name": "Famous place",
            "description": "Detailed description",
            "latitude": 0,
            "longitude": 0,
            "activities": [
                "Activity 1",
                "Activity 2"
            ],
            "best_time": "Best time",
            "cost": "$50"
        }}
    ],

    "itinerary": [
        {{
            "day": 1,
            "title": "Day title",
            "morning": "Morning plan",
            "afternoon": "Afternoon plan",
            "evening": "Evening plan",
            "food": "Food recommendation",
            "transport": "Transport",
            "cost": "$200"
        }}
    ],

    "food": [
        "Food 1",
        "Food 2",
        "Food 3",
        "Food 4",
        "Food 5"
    ],

    "budget": {{
        "hotel": "$1000",
        "food": "$500",
        "transport": "$300",
        "activities": "$500",
        "shopping": "$200",
        "emergency": "$200",
        "total": "$2700",
        "remaining": "$300"
    }},

    "tips": [
        "Tip 1",
        "Tip 2",
        "Tip 3",
        "Tip 4",
        "Tip 5"
    ]
}}

IMPORTANT:

1. Create exactly {days} days.
2. Give at least 8 famous places.
3. Famous places must actually exist.
4. Latitude and longitude must be approximate real coordinates.
5. Give detailed descriptions.
6. Include famous tourist attractions.
7. Include local experiences.
8. Include local food.
9. Include realistic costs.
10. Keep total budget within ${budget}.
"""

    models = [
        "gemini-3.6-flash",
        "gemini-3.5-flash-lite"
    ]

    for model in models:

        for attempt in range(3):

            try:

                print(
                    f"🤖 Using {model}..."
                )

                response = client.models.generate_content(
                    model=model,
                    contents=prompt
                )

                text = response.text.strip()

                # Remove markdown
                text = text.replace(
                    "```json",
                    ""
                )

                text = text.replace(
                    "```",
                    ""
                )

                text = text.strip()

                return json.loads(text)

            except Exception as e:

                print(
                    f"⚠️ Attempt {attempt + 1} failed"
                )

                print(e)

                time.sleep(3)

    raise Exception(
        "Gemini API is currently unavailable."
    )


# =========================================================
# GET IMAGE FROM WIKIPEDIA
# =========================================================

def get_place_image(place, country):

    url = "https://en.wikipedia.org/w/api.php"

    params = {
        "action": "query",
        "format": "json",
        "generator": "search",
        "gsrsearch": f"{place} {country}",
        "gsrlimit": 1,
        "prop": "pageimages|info",
        "inprop": "url",
        "pithumbsize": 700
    }

    headers = {
        "User-Agent": "AI-Travel-Planner"
    }

    try:

        response = requests.get(
            url,
            params=params,
            headers=headers,
            timeout=10
        )

        data = response.json()

        pages = (
            data
            .get("query", {})
            .get("pages", {})
        )

        for page in pages.values():

            thumbnail = page.get(
                "thumbnail"
            )

            if thumbnail:

                return thumbnail["source"]

    except Exception as e:

        print(
            f"Image error: {e}"
        )

    return None


