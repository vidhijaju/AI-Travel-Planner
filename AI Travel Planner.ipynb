   "id": "63de9d2d-93d3-4501-b90b-b146186d7ce1",
   "metadata": {},
   "source": [
    "## ✈️ AI Powered Travel Planner in Python"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1de1d6b5-6d0f-4c70-9dcf-c639ee8e6a43",
   "metadata": {},
   "outputs": [],
   "source": [
    "from google import genai\n",
    "import requests\n",
    "import json\n",
    "import time\n",
    "import os",
    "import folium\n",
    "from IPython.display import display, Image, HTML\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# GEMINI API\n",
    "# =========================================================\n",
    "\n",
    "API_KEY = os.environ['AQ.Ab8RN6Lj3rX8WEDZZRO9fdx9NQR6x-gWTpYOteZWFQpkpl1bXAY']"
    "\n",
    "client = genai.Client(\n",
    "    api_key=API_KEY\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# GET TRAVEL DATA FROM GEMINI\n",
    "# =========================================================\n",
    "\n",
    "def create_travel_plan(country, days, budget):\n",
    "\n",
    "    prompt = f\"\"\"\n",
    "Create a detailed travel plan for:\n",
    "\n",
    "Country: {country}\n",
    "Number of Days: {days}\n",
    "Budget: ${budget}\n",
    "\n",
    "Return ONLY valid JSON.\n",
    "\n",
    "Use this structure:\n",
    "\n",
    "{{\n",
    "    \"country\": \"{country}\",\n",
    "\n",
    "    \"overview\": \"Detailed overview\",\n",
    "\n",
    "    \"famous_places\": [\n",
    "        {{\n",
    "            \"name\": \"Famous place\",\n",
    "            \"description\": \"Detailed description\",\n",
    "            \"latitude\": 0,\n",
    "            \"longitude\": 0,\n",
    "            \"activities\": [\n",
    "                \"Activity 1\",\n",
    "                \"Activity 2\"\n",
    "            ],\n",
    "            \"best_time\": \"Best time\",\n",
    "            \"cost\": \"$50\"\n",
    "        }}\n",
    "    ],\n",
    "\n",
    "    \"itinerary\": [\n",
    "        {{\n",
    "            \"day\": 1,\n",
    "            \"title\": \"Day title\",\n",
    "            \"morning\": \"Morning plan\",\n",
    "            \"afternoon\": \"Afternoon plan\",\n",
    "            \"evening\": \"Evening plan\",\n",
    "            \"food\": \"Food recommendation\",\n",
    "            \"transport\": \"Transport\",\n",
    "            \"cost\": \"$200\"\n",
    "        }}\n",
    "    ],\n",
    "\n",
    "    \"food\": [\n",
    "        \"Food 1\",\n",
    "        \"Food 2\",\n",
    "        \"Food 3\",\n",
    "        \"Food 4\",\n",
    "        \"Food 5\"\n",
    "    ],\n",
    "\n",
    "    \"budget\": {{\n",
    "        \"hotel\": \"$1000\",\n",
    "        \"food\": \"$500\",\n",
    "        \"transport\": \"$300\",\n",
    "        \"activities\": \"$500\",\n",
    "        \"shopping\": \"$200\",\n",
    "        \"emergency\": \"$200\",\n",
    "        \"total\": \"$2700\",\n",
    "        \"remaining\": \"$300\"\n",
    "    }},\n",
    "\n",
    "    \"tips\": [\n",
    "        \"Tip 1\",\n",
    "        \"Tip 2\",\n",
    "        \"Tip 3\",\n",
    "        \"Tip 4\",\n",
    "        \"Tip 5\"\n",
    "    ]\n",
    "}}\n",
    "\n",
    "IMPORTANT:\n",
    "\n",
    "1. Create exactly {days} days.\n",
    "2. Give at least 8 famous places.\n",
    "3. Famous places must actually exist.\n",
    "4. Latitude and longitude must be approximate real coordinates.\n",
    "5. Give detailed descriptions.\n",
    "6. Include famous tourist attractions.\n",
    "7. Include local experiences.\n",
    "8. Include local food.\n",
    "9. Include realistic costs.\n",
    "10. Keep total budget within ${budget}.\n",
    "\"\"\"\n",
    "\n",
    "    models = [\n",
    "        \"gemini-3.6-flash\",\n",
    "        \"gemini-3.5-flash-lite\"\n",
    "    ]\n",
    "\n",
    "    for model in models:\n",
    "\n",
    "        for attempt in range(3):\n",
    "\n",
    "            try:\n",
    "\n",
    "                print(\n",
    "                    f\"🤖 Using {model}...\"\n",
    "                )\n",
    "\n",
    "                response = client.models.generate_content(\n",
    "                    model=model,\n",
    "                    contents=prompt\n",
    "                )\n",
    "\n",
    "                text = response.text.strip()\n",
    "\n",
    "                # Remove markdown\n",
    "                text = text.replace(\n",
    "                    \"```json\",\n",
    "                    \"\"\n",
    "                )\n",
    "\n",
    "                text = text.replace(\n",
    "                    \"```\",\n",
    "                    \"\"\n",
    "                )\n",
    "\n",
    "                text = text.strip()\n",
    "\n",
    "                return json.loads(text)\n",
    "\n",
    "            except Exception as e:\n",
    "\n",
    "                print(\n",
    "                    f\"⚠️ Attempt {attempt + 1} failed\"\n",
    "                )\n",
    "\n",
    "                print(e)\n",
    "\n",
    "                time.sleep(3)\n",
    "\n",
    "    raise Exception(\n",
    "        \"Gemini API is currently unavailable.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# GET IMAGE FROM WIKIPEDIA\n",
    "# =========================================================\n",
    "\n",
    "def get_place_image(place, country):\n",
    "\n",
    "    url = \"https://en.wikipedia.org/w/api.php\"\n",
    "\n",
    "    params = {\n",
    "        \"action\": \"query\",\n",
    "        \"format\": \"json\",\n",
    "        \"generator\": \"search\",\n",
    "        \"gsrsearch\": f\"{place} {country}\",\n",
    "        \"gsrlimit\": 1,\n",
    "        \"prop\": \"pageimages|info\",\n",
    "        \"inprop\": \"url\",\n",
    "        \"pithumbsize\": 700\n",
    "    }\n",
    "\n",
    "    headers = {\n",
    "        \"User-Agent\": \"AI-Travel-Planner\"\n",
    "    }\n",
    "\n",
    "    try:\n",
    "\n",
    "        response = requests.get(\n",
    "            url,\n",
    "            params=params,\n",
    "            headers=headers,\n",
    "            timeout=10\n",
    "        )\n",
    "\n",
    "        data = response.json()\n",
    "\n",
    "        pages = (\n",
    "            data\n",
    "            .get(\"query\", {})\n",
    "            .get(\"pages\", {})\n",
    "        )\n",
    "\n",
    "        for page in pages.values():\n",
    "\n",
    "            thumbnail = page.get(\n",
    "                \"thumbnail\"\n",
    "            )\n",
    "\n",
    "            if thumbnail:\n",
    "\n",
    "                return thumbnail[\"source\"]\n",
    "\n",
    "    except Exception as e:\n",
    "\n",
    "        print(\n",
    "            f\"Image error: {e}\"\n",
    "        )\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# USER INPUT\n",
    "# =========================================================\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"🌍 AI TRAVEL PLANNER\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "country = input(\n",
    "    \"\\n🌍 Enter Country: \"\n",
    ")\n",
    "\n",
    "days = int(\n",
    "    input(\"📅 Number of Days: \")\n",
    ")\n",
    "\n",
    "budget = float(\n",
    "    input(\"💰 Budget ($): \")\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# GENERATE PLAN\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"🤖 CREATING TRAVEL PLAN...\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "plan = create_travel_plan(\n",
    "    country,\n",
    "    days,\n",
    "    budget\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# BASIC INFORMATION\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\n",
    "    f\"🌍 {country.upper()}\"\n",
    ")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(\"\\n📖 OVERVIEW\")\n",
    "print(\"-\" * 70)\n",
    "\n",
    "print(\n",
    "    plan[\"overview\"]\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# GET FAMOUS PLACE IMAGES\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"📸 FINDING FAMOUS PLACE IMAGES\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "for place in plan[\"famous_places\"]:\n",
    "\n",
    "    name = place[\"name\"]\n",
    "\n",
    "    print(\n",
    "        f\"📷 {name}\"\n",
    "    )\n",
    "\n",
    "    image = get_place_image(\n",
    "        name,\n",
    "        country\n",
    "    )\n",
    "\n",
    "    place[\"image\"] = image\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# FAMOUS PLACES + IMAGES\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"📸 FAMOUS PLACES\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "for i, place in enumerate(\n",
    "    plan[\"famous_places\"],\n",
    "    1\n",
    "):\n",
    "\n",
    "    print(\n",
    "        f\"\\n{i}. 📍 {place['name']}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"📝 {place['description']}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"⏰ Best Time: \"\n",
    "        f\"{place['best_time']}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"💰 Cost: \"\n",
    "        f\"{place['cost']}\"\n",
    "    )\n",
    "\n",
    "    print(\"\\n🎯 Activities:\")\n",
    "\n",
    "    for activity in place[\n",
    "        \"activities\"\n",
    "    ]:\n",
    "\n",
    "        print(\n",
    "            f\"   • {activity}\"\n",
    "        )\n",
    "\n",
    "    # Display image in Jupyter\n",
    "    if place[\"image\"]:\n",
    "\n",
    "        try:\n",
    "\n",
    "            display(\n",
    "                Image(\n",
    "                    url=place[\"image\"],\n",
    "                    width=500\n",
    "                )\n",
    "            )\n",
    "\n",
    "        except:\n",
    "\n",
    "            print(\n",
    "                \"⚠️ Image could not be displayed.\"\n",
    "            )\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# CONNECT PLACES WITH LINE\n",
    "# =========================================================\n",
    "\n",
    "coordinates = []\n",
    "\n",
    "for place in places:\n",
    "\n",
    "    coordinates.append([\n",
    "        place[\"latitude\"],\n",
    "        place[\"longitude\"]\n",
    "    ])\n",
    "\n",
    "\n",
    "folium.PolyLine(\n",
    "\n",
    "    coordinates,\n",
    "\n",
    "    color=\"blue\",\n",
    "\n",
    "    weight=4,\n",
    "\n",
    "    opacity=0.7\n",
    "\n",
    ").add_to(travel_map)\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# DISPLAY MAP\n",
    "# =========================================================\n",
    "\n",
    "print(\n",
    "    \"\\n🗺️ Interactive map ready!\"\n",
    ")\n",
    "\n",
    "display(travel_map)\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# DAY BY DAY ITINERARY\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"📅 COMPLETE DAY-BY-DAY ITINERARY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "\n",
    "for day in plan[\"itinerary\"]:\n",
    "\n",
    "    print(\n",
    "        f\"\\n{'=' * 70}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"📅 DAY {day['day']}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"📍 {day['title']}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"{'=' * 70}\"\n",
    "    )\n",
    "\n",
    "    print(\"\\n🌅 MORNING\")\n",
    "    print(\n",
    "        day[\"morning\"]\n",
    "    )\n",
    "\n",
    "    print(\"\\n☀️ AFTERNOON\")\n",
    "    print(\n",
    "        day[\"afternoon\"]\n",
    "    )\n",
    "\n",
    "    print(\"\\n🌙 EVENING\")\n",
    "    print(\n",
    "        day[\"evening\"]\n",
    "    )\n",
    "\n",
    "    print(\"\\n🍜 FOOD\")\n",
    "    print(\n",
    "        day[\"food\"]\n",
    "    )\n",
    "\n",
    "    print(\"\\n🚕 TRANSPORT\")\n",
    "    print(\n",
    "        day[\"transport\"]\n",
    "    )\n",
    "\n",
    "    print(\"\\n💰 COST\")\n",
    "    print(\n",
    "        day[\"cost\"]\n",
    "    )\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# FOOD\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"🍜 MUST-TRY FOOD\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "for food in plan[\"food\"]:\n",
    "\n",
    "    print(\n",
    "        f\"🍴 {food}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# BUDGET\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"💰 BUDGET BREAKDOWN\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "b = plan[\"budget\"]\n",
    "\n",
    "print(\n",
    "    f\"\\n🏨 Hotel: {b['hotel']}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"🍜 Food: {b['food']}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"🚕 Transport: {b['transport']}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"🎯 Activities: {b['activities']}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"🛍️ Shopping: {b['shopping']}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"🚨 Emergency: {b['emergency']}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"\\n💰 TOTAL: {b['total']}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"💵 REMAINING: {b['remaining']}\"\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# TIPS\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"✈️ TRAVEL TIPS\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "for tip in plan[\"tips\"]:\n",
    "\n",
    "    print(\n",
    "        f\"✓ {tip}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"🎉 TRAVEL PLAN COMPLETE!\")\n",
    "print(\"=\" * 70)"
   ]
  },
